# One node instance of one master (deploy/node/docker-compose.yml). Copy to deploy/node/.env,
# fill the values and start the node with
#   docker compose -f deploy/node/docker-compose.yml --env-file deploy/node/.env up -d
# A machine that runs several nodes keeps one env file per node and passes it with --env-file.
# Real env files hold the pairing token and are gitignored.

# ---- Master: the three values the master's pairing token command prints, and the master id ----
# https://<address>:<port> of the master's cluster API, an address listed in its certificate.
SCENEGEMS_MASTER_URL=https://192.168.1.10:8443
# The master's id (SCENEGEMS_MASTER_ID in the master's deploy/master/.env).
SCENEGEMS_MASTER_ID=master
# SHA-256 of the master's CA certificate. The node refuses a master whose CA does not match.
SCENEGEMS_MASTER_CA_SHA256=
# One-time pairing token. Needed for the first start only; the node keeps its credentials in
# its state volume and can be started without the token afterwards.
SCENEGEMS_PAIRING_TOKEN=

# ---- This node ----
# Name of the node on the master and in Docker names: lowercase letters, digits and hyphens,
# unique among this machine's nodes of the same master.
SCENEGEMS_NODE_NAME=worker-1
# Job types and how many of each run at once (slots). Types: scene_generation,
# trajectory_generation, simulation.kinematic, simulation.ardupilot, monitoring.post_hoc.
SCENEGEMS_NODE_CAPABILITIES=simulation.kinematic:4,scene_generation:1,trajectory_generation:1,monitoring.post_hoc:2
# Optional labels jobs can require, as key=value pairs.
SCENEGEMS_NODE_LABELS=
# Optional local frame of the pooled services: latitude,longitude,radius in meters.
SCENEGEMS_NODE_REFERENCE_GEOFENCE=

# ---- Images and checkout ----
# Tag of the scenegems-node image (built by ./build.sh --node).
SCENEGEMS_NODE_IMAGE_TAG=latest
# The checkout the images were built from, relative to deploy/node/ or absolute; mounted read-only.
SCENEGEMS_CHECKOUT_DIR=../..
# Optional: the revision the node reports to the master; read from the checkout when empty.
SCENEGEMS_SOFTWARE_REVISION=
# Optional subsystem image overrides; empty means scenegems-<subsystem>:latest.
SCENARIO_GENERATION_IMAGE=
TRAJECTORY_GENERATION_IMAGE=
MONITORING_IMAGE=
SCENARIO_EXECUTION_IMAGE=
