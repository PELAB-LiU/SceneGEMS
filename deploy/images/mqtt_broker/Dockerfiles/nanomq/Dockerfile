# NanoMQ 0.25.6, pinned by digest: the cluster broker's TLS listener, HTTP login hook and
# ${username} access rules were verified on this release (design doc 13.8, P3.6).
FROM emqx/nanomq:0.25.6-slim@sha256:f42285e8936e5c08cde7a3430aab5face26a3bf707bf5eff05f1e1131d0ff22e

# Configuration of the workbench broker: plain MQTT, anonymous, published on 127.0.0.1 only
# (deploy/master/docker-compose.yml). The cluster broker runs the same image with a
# configuration generated by `python -m scenegems_tool.cluster.security init`, mounted
# read-only at /etc/scenegems/broker.
COPY nanomq.conf /etc/nanomq.conf

EXPOSE 1883 8883

CMD ["nanomq", "start", "--conf", "/etc/nanomq.conf"]
