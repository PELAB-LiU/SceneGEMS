# The .env of one master, next to its docker-compose.yml. The deployment tool writes it from
# the master role of release.json (scenegems_tool.cluster.release.roles): fixed values, the
# operator's parameters, and secrets it generates once on the machine and keeps afterwards.
# This template lists every key. Real .env files are never committed.

# ---- Identity ----
# Lowercase letters, digits and hyphens. It names the cluster's topics (scenegems/<id>/...),
# the compose project and the containers, so every master needs its own.
SCENEGEMS_MASTER_ID=master-1
# Keep it scenegems-<SCENEGEMS_MASTER_ID>: it scopes the network and the Postgres volume.
COMPOSE_PROJECT_NAME=scenegems-master-1
# Addresses nodes use to reach this master, comma separated: the machine's VPN address. They go
# into the API and broker certificates, so changing them needs `security init` again.
SCENEGEMS_MASTER_ADDRESSES=10.88.0.2

# ---- Ports (parameters; a second master on the same machine needs other ports) ----
# Node API over HTTPS (CA certificate, pairing, control WebSocket) and its host address
SCENEGEMS_API_PORT=8443
SCENEGEMS_API_BIND_ADDRESS=0.0.0.0
# Cluster broker, MQTT over TLS for every node, and its host address
SCENEGEMS_BROKER_TLS_PORT=8883
SCENEGEMS_BROKER_BIND_ADDRESS=0.0.0.0
# Operator API and workbench gateway, published on 127.0.0.1 only: neither has authentication
SCENEGEMS_OPERATOR_PORT=5174
# Postgres, published on 127.0.0.1 only
POSTGRES_HOST_PORT=5432

# ---- Postgres ----
POSTGRES_DB=scenegems
POSTGRES_USER=scenegems
# Generated. URL-safe characters only, since master-api puts it into a database URL.
POSTGRES_PASSWORD=

# ---- Security folder and cluster broker ----
# CA (ca/ca_certificate.pem, ca/ca_key.pem), API and broker certificates, hashed node
# credentials, relative to this folder. Created by `security init`. Losing the CA key means
# pairing every node again.
SCENEGEMS_SECURITY_DIR=./security_data
# The master's own broker account; it may use every topic under scenegems/<master id>/.
# master-api logs in with it to observe pools for the UI's live channel.
# Node accounts are created at pairing and never appear here.
SCENEGEMS_BROKER_MASTER_USERNAME=master
# Generated, at least 16 characters.
SCENEGEMS_BROKER_MASTER_PASSWORD=
# The broker checks each login by calling master-api on the compose network, with this secret.
SCENEGEMS_BROKER_AUTH_HOOK_URL=http://master-api:8090/cluster/broker/auth
# Generated, at least 32 characters from A-Z, a-z, 0-9, _ and -.
SCENEGEMS_BROKER_AUTH_HOOK_SECRET=

# ---- Artifact store (parameters) ----
# Largest artifact (job input or result, uncompressed) a node may upload, in bytes: 256 MiB
SCENEGEMS_ARTIFACT_MAX_BYTES=268435456
# How often unreferenced artifacts are deleted, in seconds; 0 turns the sweep off
SCENEGEMS_ARTIFACT_SWEEP_INTERVAL_S=600
# How long an unreferenced artifact is kept after its last use, in seconds
SCENEGEMS_ARTIFACT_SWEEP_GRACE_S=3600

# ---- Optional ----
# The URL pairing hands to nodes; empty means https://<first address>:<SCENEGEMS_API_PORT>
SCENEGEMS_MASTER_URL=
# Broker address handed to nodes; empty means the first SCENEGEMS_MASTER_ADDRESSES entry
SCENEGEMS_BROKER_PUBLIC_HOST=
# Image of master-api and the security tool
SCENEGEMS_MASTER_IMAGE=scenegems-backend:latest
