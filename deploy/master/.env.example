# Runtime secrets and ports of one master. Copy to deploy/master/.env (gitignored) and fill in.
# Docker Compose reads deploy/master/.env next to docker-compose.yml.

# Master identity and API (P3.6)
# Lowercase letters, digits and hyphens. It names the cluster's topics (scenegems/<id>/...)
# and the master's containers, so every master on a network needs its own.
SCENEGEMS_MASTER_ID=master-1
# IP addresses and host names nodes use to reach this master, comma separated (for example
# the LAN and ZeroTier addresses). They go into the API and broker certificates.
SCENEGEMS_MASTER_ADDRESSES=192.168.1.10
# HTTPS port of the master API (pairing, control WebSocket)
SCENEGEMS_API_PORT=8443

# Certificate authority and security folder (P3.6)
# Created by: python -m scenegems_tool.cluster.security --env-file deploy/master/.env init
# Holds the CA (ca/ca_certificate.pem, ca/ca_key.pem), the API and broker certificates and
# the hashed node credentials. A relative path is relative to deploy/master. Back it up:
# losing the CA key means pairing every node again.
SCENEGEMS_SECURITY_DIR=./security_data

# Cluster broker (P3.6): MQTT over TLS for every node, started with the compose profile cluster
# Host address and port the TLS listener is published on
SCENEGEMS_BROKER_BIND_ADDRESS=0.0.0.0
SCENEGEMS_BROKER_TLS_PORT=8883
# Address handed to nodes at pairing; empty means the first SCENEGEMS_MASTER_ADDRESSES entry
SCENEGEMS_BROKER_PUBLIC_HOST=
# The master's own broker account; it may use every topic under scenegems/<master id>/.
# Node accounts are created at pairing and never appear here.
SCENEGEMS_BROKER_MASTER_USERNAME=master
# At least 16 characters, for example: python -c "import secrets; print(secrets.token_urlsafe(32))"
SCENEGEMS_BROKER_MASTER_PASSWORD=
# The broker checks each login by calling this master endpoint, with this shared secret
# (at least 32 characters from A-Z, a-z, 0-9, _ and -)
SCENEGEMS_BROKER_AUTH_HOOK_URL=http://master-api:8090/cluster/broker/auth
SCENEGEMS_BROKER_AUTH_HOOK_SECRET=
