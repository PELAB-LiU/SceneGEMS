# Runtime secrets and ports of one master. Copy to deploy/master/.env (gitignored) and fill in.
# Docker Compose reads deploy/master/.env next to docker-compose.yml.

# Postgres: job store and node registry
POSTGRES_DB=scenegems
POSTGRES_USER=scenegems
POSTGRES_PASSWORD=change-me
# Published on 127.0.0.1 only
POSTGRES_HOST_PORT=5432
# How the master connects; inside the compose network the host is "postgres", port 5432
SCENEGEMS_DATABASE_URL=postgresql+psycopg://scenegems:change-me@127.0.0.1:5432/scenegems
